# Copy this file to .env.local for local development.
# Never commit .env.local.

# Local Supabase (`pnpm run db:start`, then `supabase status`).
# Preview and Production on Vercel still need the hosted project values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional geofence config for duty sign-in (client side)
NEXT_PUBLIC_STUDIO_LAT=39.181074
NEXT_PUBLIC_STUDIO_LNG=117.121380
NEXT_PUBLIC_STUDIO_RADIUS_METERS=80
NEXT_PUBLIC_STUDIO_MAX_GEO_ACCURACY_METERS=100
NEXT_PUBLIC_ENABLE_WEB_VITALS_DEBUG=false

# Seeded by supabase/seed.sql for local development and CI.
# CI does not read these from GitHub secrets.
E2E_MEMBER_EMAIL=e2e.member@club.local
E2E_MEMBER_PASSWORD=e2e-member-pass
E2E_ADMIN_EMAIL=e2e.admin@club.local
E2E_ADMIN_PASSWORD=e2e-admin-pass
E2E_KEY_RECEIVER_EMAIL=e2e.receiver@club.local
E2E_KEY_RECEIVER_PASSWORD=e2e-receiver-pass
