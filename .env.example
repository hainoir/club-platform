# Copy this file to .env.local for local development.
# Never commit .env.local.

# Public Supabase config
# These two variables should be configured in Vercel for both Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential used by Web Push APIs and dispatcher.
# Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# PWA Web Push (generate with: pnpm run push:vapid)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:maintainer@example.com
PUSH_DISPATCH_SECRET=

# Optional geofence config for duty sign-in (client side)
NEXT_PUBLIC_STUDIO_LAT=39.181074
NEXT_PUBLIC_STUDIO_LNG=117.121380
NEXT_PUBLIC_STUDIO_RADIUS_METERS=80
NEXT_PUBLIC_STUDIO_MAX_GEO_ACCURACY_METERS=100
NEXT_PUBLIC_ENABLE_WEB_VITALS_DEBUG=false

# Optional e2e credentials (used by smoke tests)
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_KEY_RECEIVER_EMAIL=
E2E_KEY_RECEIVER_PASSWORD=
