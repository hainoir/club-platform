# Copy this file to .env.local for local development.
# Never commit .env.local.

# Public Supabase config
# These two variables should be configured in Vercel for both Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Client-side geofence hint for the duty check-in button.
# These values are not enforced. The database table public.studio_geofence is
# the source of truth: submit_duty_sign_in and the duty_logs insert trigger
# reject fixes outside that fence. Keep the hint in sync with that row or the
# button will allow a location the server then refuses.
#
# Replace the placeholders with the studio's WGS84 latitude and longitude.
# Non-numeric values are ignored. The UI then falls back to the built-in
# defaults in lib/studio/studio-location.ts (the same point seeded into
# public.studio_geofence: 50 meter radius, 100 meter accuracy ceiling).
# Leave the radius and accuracy lines blank to use those defaults. Do not
# commit a real deployment's coordinates in this file.
NEXT_PUBLIC_STUDIO_LAT=<YOUR_STUDIO_LATITUDE>
NEXT_PUBLIC_STUDIO_LNG=<YOUR_STUDIO_LONGITUDE>
NEXT_PUBLIC_STUDIO_RADIUS_METERS=
NEXT_PUBLIC_STUDIO_MAX_GEO_ACCURACY_METERS=
NEXT_PUBLIC_ENABLE_WEB_VITALS_DEBUG=false

# Optional e2e credentials (used by smoke tests)
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_KEY_RECEIVER_EMAIL=
E2E_KEY_RECEIVER_PASSWORD=
