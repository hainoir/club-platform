{
  "name": "club-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib proxy.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:react": "vitest run",
    "test": "pnpm run test:unit && pnpm run test:react",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/smoke --reporter=line",
    "e2e:readonly": "playwright test tests/e2e/auth-login.spec.ts tests/e2e/auth-refresh-regression.spec.ts tests/e2e/dashboard-signin-entry.spec.ts tests/e2e/duty-flow.spec.ts tests/e2e/members-search-stability.spec.ts tests/e2e/members-table-horizontal-scroll.spec.ts --reporter=line",
    "e2e:mutation": "playwright test tests/e2e/admin-duty-smoke.spec.ts tests/e2e/admin-studio-members.spec.ts tests/e2e/auth-lock-reload.spec.ts tests/e2e/duty-rpc-integration.spec.ts tests/e2e/duty-signin-error.spec.ts tests/e2e/event-rsvp.spec.ts tests/e2e/self-study-location.spec.ts tests/e2e/self-study-name.spec.ts tests/e2e/settings-profile-save.spec.ts tests/e2e/settings-geofence.spec.ts --reporter=line",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "gen:types": "supabase gen types --lang typescript --local --schema public > types/supabase.ts && node scripts/relax-generated-member-email.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19",
    "react-day-picker": "^9.14.0",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/echarts": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "postcss": "8.5.31",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.4",
      "ws@>=8.0.0 <8.21.0": "8.22.0"
    }
  }
}
